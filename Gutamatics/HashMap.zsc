class yzHasher abstract {
	abstract virtualscope uint hash(Object o);
	abstract virtualscope bool eq(Object o0, Object o1);
	static void hashCombine(out uint seed, uint other) {
		seed ^= other + 0x9E3779B9 + (seed << 6) + (seed >> 2);
	}
}

class yzBoxedInt {
	int val;
	static yzBoxedInt create(int val) {
		let ret = new();
		ret.val = val;
		return ret;
	}
	yzBoxedInt clone() {
		let ret = new();
		ret.val = self.val;
		return ret;
	}
}
class yzIntHasher : yzHasher {
	override uint hash(Object o) { return yzBoxedInt(o).val; }
	override bool eq(Object o0, Object o1) { return yzBoxedInt(o0).val == yzBoxedInt(o1).val; }
}

class yzBoxedUInt {

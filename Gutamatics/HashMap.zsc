}
class yzUIntHasher : yzHasher {
	override uint hash(Object o) { return yzBoxedUInt(o).val; }
	override bool eq(Object o0, Object o1) { return yzBoxedUInt(o0).val == yzBoxedUInt(o1).val; }
}

